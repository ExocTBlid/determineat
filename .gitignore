# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/

# Environment files — never commit secrets
.env
.env.local
.env.*.local

# Terraform
# .terraform/ is the local provider cache; state files may contain secrets.
# The .terraform.lock.hcl (provider version lock) IS committed — do not ignore it.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/*.tfstate.*.backup
infra/terraform.tfvars
infra/backend.hcl

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Prisma generated client (regenerated on install/migrate)
backend/src/generated/
