# Test database — points to the postgres_test container in docker-compose.yml
# Used by all integration tests. DATABASE_URL is set to the SAME test DB so the
# app's Prisma singleton (which reads DATABASE_URL at import) also targets it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/determineat_test
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/determineat_test

NODE_ENV=test
