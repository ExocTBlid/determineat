# Database — points to local PostgreSQL via docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/determineat

# AWS Cognito — required for JWT verification (Tasks 3+)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1

# App
PORT=3000
NODE_ENV=development

# Local dev auth bypass — set to "dev" to SKIP Cognito JWT verification and run
# every request as a fixed dev user (no live Cognito pool needed). Leave unset
# to require real Cognito tokens. Ignored/refused when NODE_ENV=production: the
# server will refuse to start if AUTH_MODE=dev and NODE_ENV=production.
AUTH_MODE=dev
