# Copy to terraform.tfvars and adjust for your deployment.
# terraform.tfvars is gitignored — never commit real values.

aws_region   = "us-east-1"
environment  = "prod"
project_name = "determineat"

# GitHub repo (owner/repo) allowed to deploy via OIDC. Leave empty to skip
# creating the CI/CD role and OIDC provider.
github_repository = "your-username/determineat"

# Email subscribed to CloudWatch alerts (SNS). Leave empty to create the topic
# without a subscription. You must confirm the subscription email AWS sends.
alert_email = "you@example.com"

# Container image pushed to ECR. CI overrides this with a SHA-tagged image.
# Leave empty for the first apply; the ECS service will use a placeholder.
container_image = ""

# HTTPS: provide an ACM cert ARN (in the same region) and the public app URL.
# Without a cert, only an HTTP listener is created.
acm_certificate_arn = ""
app_domain_url      = ""

# Database sizing (Aurora Serverless v2 ACUs)
# min_capacity = 0 enables auto-pause: the cluster scales to zero and stops
# billing compute after a period of inactivity, resuming on the next connection
# (cold start of a few seconds). Set to 0.5 to keep it always warm instead.
aurora_min_capacity = 0
aurora_max_capacity = 2
