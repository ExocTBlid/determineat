# AWS Cognito — required for auth flow (Task 5+)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=us-east-1

# API base URL — points to Express backend
VITE_API_URL=http://localhost:3000

# Local dev auth bypass — set to "dev" to SKIP the Cognito sign-in UI and run as
# a fixed dev user. Must match the backend's AUTH_MODE. Leave unset to use the
# real Cognito Authenticator.
VITE_AUTH_MODE=dev
